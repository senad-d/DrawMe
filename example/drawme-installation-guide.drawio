        <mxCell id="start" value="&lt;b&gt;In your terminal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:17px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:18px&quot;&gt;cd /path/to/project&lt;br&gt;pi&lt;/font&gt;&lt;br&gt;Grant project trust after review&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#0F172A;fontSize=21;fontStyle=0;" vertex="1" parent="use">
          <mxGeometry x="25" y="35" width="410" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Inside Pi · verify&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:19px&quot;&gt;/drawme-check&lt;/font&gt;&lt;br&gt;Reports the detected path + version&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=20;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;" vertex="1" parent="use">
