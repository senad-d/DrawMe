        <mxCell id="subtitle" value="From prerequisites to an autonomous, editable .drawio export" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#4F6475;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="1200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="badge" value="LOCAL RENDERING  •  ONE PROMPT  •  EDITABLE OUTPUT" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontStyle=1;fontColor=#2D5E36;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1">
