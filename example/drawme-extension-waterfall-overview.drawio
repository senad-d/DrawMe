        <mxCell id="stage-06" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;06&lt;/font&gt;  Holistic confirmation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#66551D&quot;&gt;The latest holistic preview is re-checked across all categories; the run continues straight to final export.&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#66500E;fillColor=#FFF8DD;strokeColor=#C89B1D;strokeWidth=2;spacing=14;shadow=1;" vertex="1" parent="1">
