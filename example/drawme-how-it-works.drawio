        <mxCell id="2" value="DrawMe: from a prompt to an editable diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="A Pi extension for authoring, per-edit validation, five focused review passes, approval, and editable exports" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#4F6475;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="FOCUSED REVIEW  •  APPROVAL-GATED  •  EDITABLE" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2D5E36;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1450" y="35" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1  END-TO-END WORKFLOW" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1800" height="440" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;1 · CHECK&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Find the draw.io CLI&lt;br&gt;Read its version&lt;br&gt;Gate v30+ features" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="30" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;2 · PLAN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose diagram type&lt;br&gt;Define relationships&lt;br&gt;Size a finite canvas&lt;br&gt;Select LR or TB flow" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="250" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;3 · AUTHOR&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mermaid on v30+&lt;br&gt;or native draw.io XML&lt;br&gt;Use exact official shapes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="470" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;4 · VALIDATE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;After every source edit&lt;br&gt;Fix every error&lt;br&gt;Review each warning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="690" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;5 · FOCUSED PREVIEWS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Named clean PNGs&lt;br&gt;Canvas &amp;amp; composition&lt;br&gt;Nodes &amp;amp; typography&lt;br&gt;Connectors&lt;br&gt;Semantics &amp;amp; polish&lt;br&gt;Holistic regression" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="910" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;6 · BOUND CORRECTIONS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Five inspections&lt;br&gt;do not count as retries&lt;br&gt;Max 5 targeted retries&lt;br&gt;Edit → validate → preview" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFF7E6;strokeColor=#D6B656;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1130" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;7 · HUMAN REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Show holistic preview&lt;br&gt;Apply targeted feedback&lt;br&gt;Recheck pass + regression&lt;br&gt;Require explicit approval" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1350" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;8 · FINAL EXPORT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only after approval&lt;br&gt;Export requested formats&lt;br&gt;PNG • SVG • PDF • JPG&lt;br&gt;Embed when supported&lt;br&gt;Clean latest preview" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1570" y="80" width="190" height="250" as="geometry" />
        </mxCell>
        <mxCell id="13" value="2  ARCHITECTURE AND RESPONSIBILITIES" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1800" height="300" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Natural-language request&lt;/b&gt;&lt;br&gt;&lt;br&gt;User runs /drawme" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="50" y="70" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Pi AI agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plans and authors&lt;br&gt;Orchestrates the loop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="360" y="70" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;DrawMe extension&lt;/b&gt;&lt;br&gt;&lt;br&gt;check • validate • export • shape search&lt;br&gt;Mermaid • layout • explain • open" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#EAF2F8;strokeColor=#1F4E78;strokeWidth=3;shadow=1;" vertex="1" parent="13">
          <mxGeometry x="710" y="70" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;draw.io desktop CLI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Renders and exports&lt;br&gt;Invoked by DrawMe tools" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="1160" y="70" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;Deliverables&lt;/b&gt;&lt;br&gt;&lt;br&gt;.drawio source&lt;br&gt;PNG • SVG • PDF • JPG" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="1490" y="70" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Compatibility&lt;/b&gt;  •  XML authoring, validation, preview, and export work on older releases  •  Mermaid conversion and ELK auto-layout require draw.io v30+" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#405466;fillColor=#F3F6F8;strokeColor=#AAB7C4;dashed=1;" vertex="1" parent="13">
          <mxGeometry x="80" y="220" width="1640" height="45" as="geometry" />
        </mxCell>
        <mxCell id="20" value="3  WHAT DRAWME IS CAPABLE OF" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1800" height="390" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;AUTHOR AND UNDERSTAND&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Natural language → draw.io&lt;br&gt;• Flowchart, architecture, UML, BPMN, ERD, C4, network, ML&lt;br&gt;• Mermaid on v30+ or native XML&lt;br&gt;• 10k+ indexed official shapes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="40" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;QUALITY AND REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Validate after every source edit&lt;br&gt;• IDs, bounds, endpoints, and geometry&lt;br&gt;• Overlap, crossing, and route warnings&lt;br&gt;• Five ordered visual quality passes&lt;br&gt;• Five-retry cap and explicit approval gate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="480" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;EXPORT AND DELIVER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• PNG, SVG, PDF, and JPG&lt;br&gt;• Editable XML in final PNG, SVG, and PDF&lt;br&gt;• Approval-gated final export&lt;br&gt;• Scale, width, border, and transparency&lt;br&gt;• Multi-page selection and desktop fine-tuning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="920" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;EXTEND AND REUSE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Explain existing diagrams as Markdown&lt;br&gt;• ELK layouts on v30+&lt;br&gt;• macOS, Linux, Windows, WSL, and headless Linux&lt;br&gt;• Packaged authoring references&lt;br&gt;• Eight model-callable tools and three commands" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#F3F9F1;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="1360" y="75" width="400" height="250" as="geometry" />
        </mxCell>
