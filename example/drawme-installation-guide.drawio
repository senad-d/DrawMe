        <mxCell id="runtime" value="&lt;b&gt;Node.js + Pi&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:17px&quot;&gt;Node.js ≥ 22.19 · node --version&lt;br&gt;Install Pi via pi.dev · pi --version&lt;br&gt;In Pi: /login, then /model&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#0F172A;fontSize=21;fontStyle=0;" vertex="1" parent="prepare">
