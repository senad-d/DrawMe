<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.9">
  <diagram id="drawme-overview" name="How DrawMe Works">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1360" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="DrawMe: from a prompt to an editable diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="A Pi extension that orchestrates authoring, quality checks, human review, and local draw.io CLI exports" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#4F6475;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="LOCAL ONLY  •  EDITABLE  •  MULTI-FORMAT" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2D5E36;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1450" y="35" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1  END-TO-END WORKFLOW" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1800" height="400" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;1 · CHECK&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Find the draw.io CLI&lt;br&gt;Read its version&lt;br&gt;Gate v30+ features" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="30" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;2 · PLAN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose diagram type&lt;br&gt;Define shapes and links&lt;br&gt;Select LR or TB flow" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="280" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;3 · AUTHOR&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mermaid on v30+&lt;br&gt;or native draw.io XML&lt;br&gt;Use exact official shapes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="530" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;4 · VALIDATE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check IDs and parents&lt;br&gt;Check edge endpoints&lt;br&gt;Flag overlap and routing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="780" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;5 · PREVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Export a clean PNG&lt;br&gt;Cap width at 2000 px&lt;br&gt;Visually inspect, max 2 rounds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1030" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;6 · REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Show the preview&lt;br&gt;Apply targeted feedback&lt;br&gt;Re-validate and re-preview" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1280" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;7 · FINAL EXPORT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;PNG by default&lt;br&gt;SVG, PDF, or JPG&lt;br&gt;Keep source editable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1530" y="80" width="210" height="215" as="geometry" />
        </mxCell>
        <mxCell id="13" value="2  LOCAL ARCHITECTURE AND RESPONSIBILITIES" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1800" height="300" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Natural-language request&lt;/b&gt;&lt;br&gt;&lt;br&gt;User runs /drawme" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="50" y="70" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Pi AI agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plans and authors&lt;br&gt;Orchestrates the loop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="360" y="70" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;DrawMe extension&lt;/b&gt;&lt;br&gt;&lt;br&gt;check • validate • export • shape search&lt;br&gt;Mermaid • layout • explain • open" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#EAF2F8;strokeColor=#1F4E78;strokeWidth=3;shadow=1;" vertex="1" parent="13">
          <mxGeometry x="710" y="70" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;draw.io desktop CLI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Renders and exports&lt;br&gt;Runs as a local process" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="1160" y="70" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;Deliverables&lt;/b&gt;&lt;br&gt;&lt;br&gt;.drawio source&lt;br&gt;PNG • SVG • PDF • JPG" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="13">
          <mxGeometry x="1490" y="70" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Detected here: draw.io 26.0.9&lt;/b&gt;  •  XML authoring, validation, preview, and export are available  •  Mermaid conversion and ELK auto-layout require v30+" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#405466;fillColor=#F3F6F8;strokeColor=#AAB7C4;dashed=1;" vertex="1" parent="13">
          <mxGeometry x="80" y="220" width="1640" height="45" as="geometry" />
        </mxCell>
        <mxCell id="20" value="3  WHAT DRAWME IS CAPABLE OF" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1800" height="390" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;AUTHOR AND UNDERSTAND&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Natural language → draw.io&lt;br&gt;• Flowchart, architecture, UML, BPMN, ERD, C4, network, ML&lt;br&gt;• Mermaid on v30+ or native XML&lt;br&gt;• 10k+ indexed official shapes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="40" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;QUALITY AND REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Deterministic structural lint&lt;br&gt;• IDs, parents, endpoints, geometry&lt;br&gt;• Overlap, crossing, and route warnings&lt;br&gt;• Preview vision check&lt;br&gt;• Human feedback refinement loop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="480" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;EXPORT AND DELIVER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• PNG, SVG, PDF, and JPG&lt;br&gt;• Editable XML embedded in final PNG, SVG, and PDF&lt;br&gt;• Scale, width, border, transparency&lt;br&gt;• Multi-page selection&lt;br&gt;• Open in desktop for fine-tuning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="920" y="75" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;OPERATE SAFELY AND REUSE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Explain existing diagrams as Markdown&lt;br&gt;• ELK layouts on v30+&lt;br&gt;• macOS, Linux, Windows, and headless Linux support&lt;br&gt;• No network calls&lt;br&gt;• Only local CLI and file opener processes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=15;fontSize=14;fontColor=#263746;fillColor=#F3F9F1;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="20">
          <mxGeometry x="1360" y="75" width="400" height="250" as="geometry" />
        </mxCell>
