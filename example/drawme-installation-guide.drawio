        </mxCell>
        <mxCell id="trust" value="&lt;b&gt;Trust before execution&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:17px&quot;&gt;Pi packages have full system access.&lt;br&gt;Review SECURITY.md and the source.&lt;br&gt;Use a vision model for rendered review.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#0F172A;fontSize=21;fontStyle=0;" vertex="1" parent="prepare">
