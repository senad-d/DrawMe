        </mxCell>
        <mxCell id="cap-quality" value="&lt;b&gt;&lt;font color=&quot;#674274&quot;&gt;VALIDATE + REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Validate every source revision&lt;br&gt;• Check IDs • parents • endpoints • geometry&lt;br&gt;• Flag bounds • overlap • route defects&lt;br&gt;• Image-aware critique + five-retry guardrail" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=16;fontSize=14;fontColor=#263746;fillColor=#FCF9FD;strokeColor=#B69BC2;strokeWidth=2;" vertex="1" parent="capabilities">
          <mxGeometry x="485" y="73" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cap-deliver" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;PREVIEW + DELIVER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Review before final export&lt;br&gt;• PNG • SVG • PDF • JPG&lt;br&gt;• Embed editable XML when supported&lt;br&gt;• Control scale • width • border • page" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=16;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#9EB9D6;strokeWidth=2;" vertex="1" parent="capabilities">
          <mxGeometry x="935" y="73" width="420" height="170" as="geometry" />
