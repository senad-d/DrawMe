        <mxCell id="cap-author" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;AUTHOR + UNDERSTAND&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Natural language → editable .drawio&lt;br&gt;• Flowchart • architecture • UML • BPMN • ERD • C4&lt;br&gt;• Mermaid on v30+ or native XML&lt;br&gt;• 10k+ indexed official shapes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=16;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#9EB9D6;strokeWidth=2;" vertex="1" parent="capabilities">
