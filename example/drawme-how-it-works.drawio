        <mxCell id="cap-reuse" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;EXTEND + REUSE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Explain diagrams as Markdown&lt;br&gt;• Apply ELK auto-layout on v30+&lt;br&gt;• Open in draw.io for fine-tuning&lt;br&gt;• macOS • Linux • Windows • WSL • headless Linux" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=16;fontSize=14;fontColor=#263746;fillColor=#F8FCF7;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="capabilities">
