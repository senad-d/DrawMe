        <mxCell id="desktop" value="&lt;b&gt;draw.io Desktop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:17px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:17px&quot;&gt;brew install --cask drawio&lt;/font&gt;&lt;br&gt;macOS command above&lt;br&gt;Linux: .deb / .rpm · Windows: installer&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#0F172A;fontSize=21;fontStyle=0;" vertex="1" parent="prepare">
