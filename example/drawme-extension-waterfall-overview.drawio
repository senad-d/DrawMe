        <mxCell id="stage-01" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;01&lt;/font&gt;  Request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#40566F&quot;&gt;Natural-language intent arrives through &lt;b&gt;/drawme&lt;/b&gt; in the Pi agent.&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#173B67;fillColor=#EAF2FF;strokeColor=#4C78C2;strokeWidth=2;spacing=14;shadow=1;" vertex="1" parent="1">
