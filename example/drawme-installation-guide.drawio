        </mxCell>
        <mxCell id="prereq-pi" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;01 · PI CODING AGENT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Install and authenticate Pi first&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi --version&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="prereqs">
          <mxGeometry x="40" y="85" width="540" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="prereq-node" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;02 · NODE.JS 22.19+&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Required by DrawMe&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node --version&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="prereqs">
          <mxGeometry x="660" y="85" width="540" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="prereq-drawio" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;03 · DRAW.IO DESKTOP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;macOS: &lt;font face=&quot;Courier New&quot;&gt;brew install --cask drawio&lt;/font&gt;&lt;br&gt;Linux: .deb / .rpm  •  Windows: official installer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="prereqs">
          <mxGeometry x="1280" y="85" width="540" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="install" value="2  INSTALL DRAWME  ·  CHOOSE ONE SCOPE" style="swimlane;horizontal=1;startSize=60;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=19;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1920" height="465" as="geometry"/>
        </mxCell>
        <mxCell id="scope-decision" value="Choose scope" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#6B5500;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="install">
          <mxGeometry x="790" y="80" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="scope-user" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;USER SCOPE · DEFAULT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;All projects  •  ~/.pi/agent/settings.json&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi install npm:@senad-d/drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#EAF2F8;strokeColor=#1F4E78;strokeWidth=3;shadow=1;" vertex="1" parent="install">
          <mxGeometry x="40" y="210" width="540" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="scope-project" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;PROJECT-LOCAL · TEAM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This project  •  .pi/settings.json&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi install npm:@senad-d/drawme -l&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="install">
          <mxGeometry x="660" y="210" width="540" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="scope-trial" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;ONE-TIME TRIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current run only  •  no settings change&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi -e npm:@senad-d/drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="install">
          <mxGeometry x="1280" y="210" width="540" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="install-source" value="&lt;b&gt;PIN OR DEVELOP&lt;/b&gt;&lt;br&gt;Pinned npm: &lt;font face=&quot;Courier New&quot;&gt;npm:@senad-d/drawme@&amp;lt;version&amp;gt;&lt;/font&gt;  •  Git: &lt;font face=&quot;Courier New&quot;&gt;git:github.com/senad-d/DrawMe@&amp;lt;tag&amp;gt;&lt;/font&gt;&lt;br&gt;Source checkout: &lt;font face=&quot;Courier New&quot;&gt;npm ci --ignore-scripts&lt;/font&gt; → &lt;font face=&quot;Courier New&quot;&gt;npm run validate&lt;/font&gt; → &lt;font face=&quot;Courier New&quot;&gt;pi --no-extensions -e .&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontSize=13;fontColor=#405466;fillColor=#F3F6F8;strokeColor=#AAB7C4;dashed=1;" vertex="1" parent="install">
          <mxGeometry x="40" y="360" width="1780" height="80" as="geometry"/>
        </mxCell>
