  <diagram id="drawme-install" name="Install DrawMe">
    <mxGraphModel dx="2000" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0" background="#F4F7FB" pageWidth="2000" pageHeight="1685">
