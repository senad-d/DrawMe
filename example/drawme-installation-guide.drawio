        <mxCell id="use" value="3  LOAD, VERIFY, DESCRIBE  ·  DRAWME DOES THE REST" style="swimlane;horizontal=1;startSize=60;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=19;fontStyle=1;fontColor=#FFFFFF;fillColor=#674274;swimlaneFillColor=#FCF9FD;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="965" width="1920" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="use-load" value="&lt;b&gt;&lt;font color=&quot;#674274&quot;&gt;01 · LOAD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start Pi after installation&lt;br&gt;Already open? Use &lt;font face=&quot;Courier New&quot;&gt;/reload&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#B69BC2;strokeWidth=2;" vertex="1" parent="use">
          <mxGeometry x="40" y="95" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="use-verify" value="&lt;b&gt;&lt;font color=&quot;#674274&quot;&gt;02 · VERIFY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/drawme-check&lt;/font&gt;&lt;br&gt;Confirm path · version · v30+ features" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#B69BC2;strokeWidth=2;" vertex="1" parent="use">
          <mxGeometry x="410" y="95" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="use-describe" value="&lt;b&gt;&lt;font color=&quot;#674274&quot;&gt;03 · DESCRIBE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/drawme a login flow with retry&lt;/font&gt;&lt;br&gt;Use plain language" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#B69BC2;strokeWidth=2;" vertex="1" parent="use">
          <mxGeometry x="780" y="95" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="use-autonomous" value="&lt;b&gt;&lt;font color=&quot;#674274&quot;&gt;04 · AUTONOMOUS RUN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;plan → author → validate → critique&lt;br&gt;refine (≤8) → confirm → export&lt;br&gt;&lt;font color=&quot;#6B7C8A&quot;&gt;no approval pause&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#F7F0FA;strokeColor=#9673A6;strokeWidth=3;shadow=1;" vertex="1" parent="use">
          <mxGeometry x="1150" y="95" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="use-delivered" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;05 · DELIVERED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Editable .drawio source&lt;br&gt;PNG by default&lt;br&gt;SVG · PDF · JPG when requested" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="use">
          <mxGeometry x="1520" y="95" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="edge-use-load-verify" value="loaded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#674274;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="use" source="use-load" target="use-verify">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="180"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="edge-use-verify-describe" value="CLI ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#674274;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="use" source="use-verify" target="use-describe">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="180"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="edge-use-describe-autonomous" value="one prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#674274;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="use" source="use-describe" target="use-autonomous">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="180"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="edge-use-autonomous-delivered" value="automatic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#2D5E36;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="use" source="use-autonomous" target="use-delivered">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="180"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="support" value="TROUBLESHOOTING, TRUST, AND COMPATIBILITY" style="swimlane;horizontal=1;startSize=56;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fillColor=#405466;swimlaneFillColor=#F8FAFB;strokeColor=#7E8E9E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1345" width="1920" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="support-cli" value="&lt;b&gt;CLI NOT FOUND?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Install draw.io Desktop at a standard path, then rerun &lt;font face=&quot;Courier New&quot;&gt;/drawme-check&lt;/font&gt;. XML authoring and validation can still run, but preview, export, Mermaid import, and ELK layout need the CLI." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#AAB7C4;" vertex="1" parent="support">
          <mxGeometry x="40" y="80" width="540" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="support-package" value="&lt;b&gt;PACKAGE NOT VISIBLE?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Run &lt;font face=&quot;Courier New&quot;&gt;pi list&lt;/font&gt;, check &lt;font face=&quot;Courier New&quot;&gt;pi config&lt;/font&gt;, and use &lt;font face=&quot;Courier New&quot;&gt;/reload&lt;/font&gt;. Project-local packages load from trusted projects; Pi installs missing project packages on startup." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#AAB7C4;" vertex="1" parent="support">
          <mxGeometry x="660" y="80" width="540" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="support-trust" value="&lt;b&gt;&lt;font color=&quot;#9A5B13&quot;&gt;INSTALL TRUSTED CODE ONLY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pi packages run with full system access. Review third-party source before installation. DrawMe reads and writes requested diagram files and may launch draw.io or the OS file opener." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=13;fontColor=#6A4513;fillColor=#FFF4E6;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="support">
          <mxGeometry x="1280" y="80" width="540" height="130" as="geometry"/>
        </mxCell>
