          <mxGeometry x="25" y="645" width="410" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="personal" value="&lt;b&gt;Personal · persistent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:17px&quot;&gt;pi install npm:@senad-d/drawme&lt;/font&gt;&lt;br&gt;Default: ~/.pi/agent/settings.json&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=20;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="scope">
          <mxGeometry x="20" y="35" width="420" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="project" value="&lt;b&gt;Project · persistent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:17px&quot;&gt;pi install npm:@senad-d/drawme -l&lt;/font&gt;&lt;br&gt; .pi/settings.json; loads after trust&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=20;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;" vertex="1" parent="scope">
          <mxGeometry x="20" y="220" width="420" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="trial" value="&lt;b&gt;One invocation · try it&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:17px&quot;&gt;pi -e npm:@senad-d/drawme&lt;/font&gt;&lt;br&gt;Starts Pi; does not change settings&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=20;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;" vertex="1" parent="scope">
