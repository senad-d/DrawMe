<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.9">
  <diagram id="drawme-install" name="Install DrawMe">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1360" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Install DrawMe for Pi" style="text;html=1;align=left;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="From prerequisites to your first locally generated .drawio diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#4F6475;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="QUICK SETUP  •  3–5 MINUTES  •  LOCAL-ONLY RUNTIME" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2D5E36;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1370" y="35" width="470" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1  CHECK THE PREREQUISITES" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;PI CODING AGENT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pi must already be installed&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi --version&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="40" y="75" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;NODE.JS 22.19+&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Required by DrawMe&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;node --version&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="650" y="75" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;DRAW.IO DESKTOP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;macOS: &lt;font face=&quot;Courier New&quot;&gt;brew install --cask drawio&lt;/font&gt;&lt;br&gt;Linux / Windows: install the official desktop release" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="5">
          <mxGeometry x="1260" y="75" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="9" value="↓" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F4E78;" vertex="1" parent="1">
          <mxGeometry x="880" y="360" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="10" value="2  INSTALL DRAWME — CHOOSE ONE SCOPE" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1800" height="360" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Choose scope" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#6B5500;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="10">
          <mxGeometry x="760" y="60" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;GLOBAL · RECOMMENDED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Available in every project&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi install npm:@senad-d/drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#EAF2F8;strokeColor=#1F4E78;strokeWidth=3;shadow=1;" vertex="1" parent="10">
          <mxGeometry x="70" y="180" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;PROJECT-LOCAL · TEAM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Saved in .pi/settings.json&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi install -l npm:@senad-d/drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="10">
          <mxGeometry x="650" y="180" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;ONE-TIME TRIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Temporary for the current run&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pi -e npm:@senad-d/drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="10">
          <mxGeometry x="1230" y="180" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Local checkout alternative:  &lt;font face=&quot;Courier New&quot;&gt;pi install /absolute/path/to/pi-drawme&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#405466;fillColor=#F3F6F8;strokeColor=#AAB7C4;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="300" y="310" width="1200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="16" value="↓" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F4E78;" vertex="1" parent="1">
          <mxGeometry x="880" y="750" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="17" value="3  LOAD, VERIFY, AND CREATE YOUR FIRST DIAGRAM" style="swimlane;horizontal=1;startSize=46;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E78;swimlaneFillColor=#F8FBFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1800" height="300" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;LOAD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start or restart Pi&lt;br&gt;Already running? Use &lt;font face=&quot;Courier New&quot;&gt;/reload&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="17">
          <mxGeometry x="60" y="85" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;VERIFY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/drawme-check&lt;/font&gt;&lt;br&gt;Expect a CLI path and version" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="17">
          <mxGeometry x="500" y="85" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;&lt;font color=&quot;#1F4E78&quot;&gt;CREATE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/drawme Create a login flow&lt;/font&gt;&lt;br&gt;Describe any diagram in plain language" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;shadow=1;" vertex="1" parent="17">
          <mxGeometry x="940" y="85" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;&lt;font color=&quot;#2D5E36&quot;&gt;DONE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receive an editable .drawio source&lt;br&gt;plus PNG by default" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=14;fontColor=#263746;fillColor=#EAF4E8;strokeColor=#82B366;strokeWidth=2;shadow=1;" vertex="1" parent="17">
          <mxGeometry x="1380" y="85" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="22" value="TROUBLESHOOTING, TRUST, AND VERSION NOTES" style="swimlane;horizontal=1;startSize=42;rounded=1;arcSize=8;container=1;pointerEvents=0;html=1;fontSize=16;fontStyle=1;fontColor=#FFFFFF;fillColor=#405466;swimlaneFillColor=#F8FAFB;strokeColor=#7E8E9E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="1800" height="180" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;CLI NOT FOUND?&lt;/b&gt;&lt;br&gt;Install draw.io Desktop, keep its standard install path, then run &lt;font face=&quot;Courier New&quot;&gt;/drawme-check&lt;/font&gt; again. v30+ is needed only for Mermaid and ELK layout." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#AAB7C4;" vertex="1" parent="22">
          <mxGeometry x="30" y="60" width="550" height="95" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;EXTENSION NOT VISIBLE?&lt;/b&gt;&lt;br&gt;Run &lt;font face=&quot;Courier New&quot;&gt;pi list&lt;/font&gt;, check &lt;font face=&quot;Courier New&quot;&gt;pi config&lt;/font&gt;, and use &lt;font face=&quot;Courier New&quot;&gt;/reload&lt;/font&gt;. Project-local packages load only after the project is trusted." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#263746;fillColor=#FFFFFF;strokeColor=#AAB7C4;" vertex="1" parent="22">
          <mxGeometry x="625" y="60" width="550" height="95" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;INSTALL TRUSTED CODE ONLY&lt;/b&gt;&lt;br&gt;Pi extensions run with your system permissions, so review third-party sources. DrawMe itself performs no network I/O; it invokes only local draw.io and file-opener processes." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#2D5E36;fillColor=#F3F9F1;strokeColor=#82B366;" vertex="1" parent="22">
          <mxGeometry x="1220" y="60" width="550" height="95" as="geometry" />
        </mxCell>
        <mxCell id="26" value="all projects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F4E78;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" value="this project" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F4E78;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" value="current run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F4E78;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F4E78;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="18" target="19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="30" value="CLI detected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#1F4E78;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="19" target="20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="exports locally" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#2D5E36;strokeWidth=2;fontSize=11;fontColor=#405466;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="20" target="21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
